# Copy to .env (`make .env` does it) and adjust. .env is git-ignored.

# Postgres
POSTGRES_DB=oque_assistir
POSTGRES_USER=oque_assistir
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Ollama
OLLAMA_PORT=11434
# Chat model pulled by the ollama container on startup and used by the server
OLLAMA_CHAT_MODEL=llama3.2:3b
